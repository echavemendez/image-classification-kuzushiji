def evaluar_knn(columnas_idx, k):
    # aseguramos enteros válidos
    columnas_idx = list(map(int, columnas_idx))

    # seleccionar por POSICIÓN
    Xtr = X_train.iloc[:, columnas_idx]
    Xte = X_test.iloc[:, columnas_idx]

